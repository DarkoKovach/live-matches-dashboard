# API Configuration
VITE_API_BASE_URL=http://172.235.235.11
VITE_API_MATCHES_ENDPOINT=/api/matches
VITE_API_USERNAME=your-email@example.com

# Polling Configuration
VITE_POLLING_INTERVAL=10000
VITE_POLLING_MAX_RETRIES=5
VITE_POLLING_RETRY_BASE_DELAY=1000
VITE_POLLING_RETRY_MAX_DELAY=16000

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG_PANEL=false
VITE_ENABLE_VIRTUAL_SCROLL=true

# Performance Monitoring
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Session Management
VITE_SESSION_TIMEOUT=3600000
VITE_MEMORY_CLEANUP_INTERVAL=300000
